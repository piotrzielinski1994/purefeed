{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/.pzielinski",
      "!!**/dist",
      "!!**/coverage",
      "!!test/assets/generated",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/.cache"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 144
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "chrome": "Use ext from src/compat/browser.ts.",
              "browser": "Use ext from src/compat/browser.ts."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/compat/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
